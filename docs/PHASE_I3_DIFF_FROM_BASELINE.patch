+def test_t_conf_2e1_structure_on_e3_and_on_m(e3, marked):
+    check_structure(*e3, E3_DRAFT)
+    _, plan_m, proposal_m = marked
+    check_structure(plan_m, proposal_m, E3_DRAFT)
