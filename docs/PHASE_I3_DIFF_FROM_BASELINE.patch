+++ b/Multi-Agent/coalition_travel/infrastructure/presentation/text_renderer.py	2026-11-20 04:05:26
@@ -0,0 +1,315 @@
+"""Readable terminal presentation of a proposal (specification §9.1, scope review §7.1).
+
+The renderer reads a ``TripProposal`` only, never an internal object of the engine. The
+text follows the canonical order of the JSON and contains no timestamp other than the
+reference date, so it is identical byte for byte for an identical proposal. The
+validated-request summary and the status messages are built from validated fields only;
+the raw text typed by the person is never copied (B9).
+"""
+
+from collections.abc import Mapping
+from decimal import Decimal
+
+from coalition_travel.application.request_contracts import TravelRequestDraft
+from coalition_travel.application.trip_proposal import (
+    JournalView,
+    TripProposal,
+)
+from coalition_travel.infrastructure.presentation.explanations_fr import (
+    REQUEST_REJECTION_MESSAGES,
+    euros,
+    euros_exact,
+    explanation_message,
+    forbidden_term_message,
+    needs_clarification_message,
+    violation_text,
+)
+from coalition_travel.infrastructure.presentation.json_renderer import ensure_vocabulary
+
+FORBIDDEN_TERM_PREFIX = "forbidden_term: "
+
+STATUS_LABELS = {
+    "served_in_coalition": "demande servie dans une coalition",
+    "alone_no_beneficial_coalition": "demande traitée seule",
+    "alone_social_optimum": "demande traitée seule",
+    "no_admissible_offer": "aucune offre admissible",
+    "no_solo_reference": "aucun prix de référence",
+    "component_too_large": "groupe de demandes trop grand pour le calcul",
+    "capacity_model_violated": "capacité des offres dépassée",
+}
+DIRECT_LABELS = {"any": "indifférent", "preferred": "préféré", "required": "exigé"}
+ACTOR_LABELS = {"seller": "vendeur", "leader": "mandataire du groupe"}
+TYPE_LABELS = {"PROPOSE": "propose", "ACCEPT": "accepte", "REJECT": "refuse"}
+NEGOTIATION_STATUS_LABELS = {
+    "agreement": "accord",
+    "rejected": "sans accord (refus)",
+    "turn_limit": "sans accord (limite de tours)",
+}
+TERMINAL_REASON_LABELS = {
+    "leader_counteroffers_exhausted": "contre-propositions du mandataire épuisées",
+    "seller_rejected": "refus du vendeur",
+    "router_iteration_limit": "limite de tours atteinte",
+}
+EXTRACTION_LABELS = {
+    "draft-json": "brouillon JSON fourni",
+    "llm": "modèle de langage local",
+    "replay": "rejeu enregistré (test et démonstration)",
+}
+
+
+def _decimal_euros(value) -> str:
+    amount = Decimal(str(value))
+    cents = amount * 100
+    if cents == cents.to_integral_value():
+        return euros(int(cents))
+    return f"{str(amount).replace('.', ',')} €"
+
+
+def _date(value) -> str:
+    return "non précisée" if value is None else str(value)
+
+
+def _suppliers(values) -> str:
+    return ", ".join(values) if values else "aucun"
+
+
+def _request_lines(draft: Mapping) -> list[str]:
+    lines = [
+        f"- destination : {draft['destination']}",
+        f"- voyageurs : {draft['travellers']}",
+        f"- budget par personne : {_decimal_euros(draft['budget_per_person'])}",
+        f"- départ au plus tôt : {_date(draft['departure_after'])}",
+        f"- arrivée au plus tard : {_date(draft['arrival_before'])}",
+        f"- vol direct : {DIRECT_LABELS[draft['direct_flight']]}",
+        f"- fournisseurs exclus : {_suppliers(draft['excluded_suppliers'])}",
+        "- ville de départ : non prise en compte dans cette version",
+    ]
+    for profile in draft["profiles"]:
+        details = [f"{profile['traveller_count']} voyageur(s)"]
+        if profile["budget_per_person"] is not None:
+            details.append(f"budget {_decimal_euros(profile['budget_per_person'])}")
+        if profile["departure_after"] is not None:
+            details.append(f"départ au plus tôt {profile['departure_after']}")
+        if profile["arrival_before"] is not None:
+            details.append(f"arrivée au plus tard {profile['arrival_before']}")
+        if profile["direct_flight"] is not None:
+            details.append(f"vol direct {DIRECT_LABELS[profile['direct_flight']]}")
+        if profile["excluded_suppliers"]:
+            details.append(f"fournisseurs exclus {_suppliers(profile['excluded_suppliers'])}")
+        lines.append(f"- profil {profile['profile_id']} : " + ", ".join(details))
+    return lines
+
+
+def render_request_summary(draft: TravelRequestDraft) -> str:
+    """Summary of the understood request, shown before the validation question."""
+    if not isinstance(draft, TravelRequestDraft):
+        raise TypeError("draft must be a TravelRequestDraft")
+    lines = ["Demande comprise :", *_request_lines(draft.model_dump(mode="json"))]
+    return ensure_vocabulary("\n".join(lines) + "\n")
+
+
+# --- proposal -----------------------------------------------------------------------------
+
+
+def _offer_lines(proposal: TripProposal) -> list[str]:
+    lines = []
+    for offer in proposal.offers:
+        kind = "vol direct" if offer.direct else "avec escale"
+        lines.append(
+            f"- {offer.offer_id} : {offer.supplier_id}, {offer.destination}, départ "
+            f"{offer.departure_date}, arrivée {offer.arrival_date}, {kind}, capacité "
+            f"{offer.capacity_seats} places"
+        )
+        tiers = " ; ".join(
+            f"dès {tier.min_seats} place(s) : {euros(tier.list_per_seat_cents)} par place"
+            for tier in offer.tiers
+        )
+        lines.append(f"  prix catalogue : {tiers}")
+        if offer.admissible:
+            lines.append("  admissible pour votre demande")
+        else:
+            reasons = " ; ".join(violation_text(v) for v in offer.violations)
+            lines.append(f"  écartée : {reasons}")
+        for note in offer.notes:
+            if note.code == "direct_preference_not_met":
+                lines.append(
+                    f"  note : préférence pour un vol direct non satisfaite (profil "
+                    f"{note.profile_id})"
+                )
+    return lines
+
+
+def _journal_lines(journal: JournalView, indent: str) -> list[str]:
+    status = NEGOTIATION_STATUS_LABELS.get(journal.status, journal.status)
+    head = (
+        f"{indent}{journal.quantity_seats} place(s), palier dès "
+        f"{journal.price_tier_min_seats} place(s), prix catalogue "
+        f"{euros(journal.catalog_total_cents)} ; {status} en {journal.turns} tour(s)"
+    )
+    if journal.agreed_total_cents is not None:
+        head += f", prix négocié (simulation) {euros(journal.agreed_total_cents)}"
+    if journal.terminal_reason is not None:
+        head += f" ({TERMINAL_REASON_LABELS.get(journal.terminal_reason, journal.terminal_reason)})"
+    lines = [head]
+    if journal.leader_initial_total_cents is not None:
+        lines.append(
+            f"{indent}première offre du mandataire : {euros(journal.leader_initial_total_cents)}"
+        )
+    for message in journal.messages:
+        actor = ACTOR_LABELS.get(message.actor, message.actor)
+        verb = TYPE_LABELS.get(message.type, message.type)
+        if message.total_cents is not None:
+            amount = euros(message.total_cents)
+        elif message.actor == "leader" and journal.leader_initial_total_cents is None:
+            amount = "montant non publié"
+        else:
+            amount = "sans montant"
+        lines.append(f"{indent}{message.index}. {actor} {verb} : {amount}")
+    return lines
+
+
+def _solo_lines(proposal: TripProposal) -> list[str]:
+    solo = proposal.solo
+    if solo is None:
+        return ["Aucune négociation : la capacité des offres est dépassée."]
+    if solo.status == "no_admissible_offer":
+        return ["Aucune négociation : aucune offre admissible."]
+    lines = []
+    if solo.status == "referenced":
+        lines.append(
+            f"Prix de référence de votre demande : {euros(solo.agreed_total_cents)} "
+            f"(offre {solo.offer_id}, prix négocié (simulation))"
+        )
+    else:
+        lines.append("Aucune négociation individuelle n'a abouti.")
+    for attempt in solo.attempts:
+        lines.append(f"- offre {attempt.offer_id} :")
+        lines.extend(_journal_lines(attempt.journal, "  "))
+    return lines
+
+
+def _block_lines(proposal: TripProposal) -> list[str]:
+    block = proposal.block
+    lines = [
+        f"Offre commune : {block.offer_id}",
+        f"Places : {block.seats} (palier dès {block.price_tier_min_seats} place(s))",
+        f"Prix catalogue : {euros(block.catalog_total_cents)}",
+        f"Prix négocié (simulation) : {euros(block.cost_cents)}",
+        f"Somme des prix de référence : {euros(block.reference_total_cents)}",
+        f"Valeur créée (économie collective) : {euros(block.value_cents)}",
+        "Membres :",
+    ]
+    for member in block.members:
+        places = f"{member.seats} place(s)"
+        lines.append(f"- {member.label} : {places}, paiement {euros(member.payment_cents)}")
+    if block.negotiation is not None:
+        lines.append("Négociation du groupe (montants du mandataire non publiés) :")
+        lines.extend(_journal_lines(block.negotiation, "  "))
+    return lines
+
+
+def _allocation_lines(proposal: TripProposal) -> list[str]:
+    allocation = proposal.allocation
+    return [
+        f"Prix de référence de votre demande : {euros(allocation.reference_cents)}",
+        f"Contribution à la valeur créée (Shapley) : {euros_exact(allocation.phi_cents)}",
+        f"Économie après ajustement : {euros_exact(allocation.y_cents)}",
+        f"Économie de votre demande : {euros(allocation.saving_cents)}",
+        f"Paiement de votre demande : {euros(allocation.payment_cents)}",
+    ]
+
+
+def _traveller_lines(proposal: TripProposal) -> list[str]:
+    lines = []
+    for traveller in proposal.travellers:
+        line = (
+            f"- profil {traveller.profile_id}, place {traveller.seat_rank} : "
+            f"{euros(traveller.amount_cents)} (budget {euros(traveller.budget_cents)})"
+        )
+        if traveller.profile_saturated:
+            line += ", budget atteint"
+        lines.append(line)
+    return lines
+
+
+def _provenance_lines(proposal: TripProposal) -> list[str]:
+    provenance = proposal.provenance
+    extraction = provenance.extraction
+    source = EXTRACTION_LABELS[extraction.source]
+    if extraction.model is not None:
+        source += f" ({extraction.provider}, {extraction.model})"
+    return [
+        f"- date de référence : {provenance.reference_date}",
+        f"- catalogue : {provenance.catalog_version}",
+        f"- carnet de demandes : {provenance.pool_version or 'aucun'}",
+        f"- planification : {provenance.planning_version}",
+        f"- formation : {provenance.formation_adapter_version} ({provenance.formation_method})",
+        f"- allocation : {provenance.allocation_version} (θ = {provenance.theta_cents})",
+        f"- extraction de la demande : {source}",
+    ]
+
+
+def render_proposal_text(proposal: TripProposal) -> str:
+    """The proposal as readable text; accepts a TripProposal only."""
+    if type(proposal) is not TripProposal:
+        raise TypeError("the text renderer accepts a TripProposal only")
+    status = proposal.explanations[0]
+    sections = [
+        [proposal.simulation.notice, f"Date de référence : {proposal.provenance.reference_date}"],
+        ["== Demande validée ==", *_request_lines(proposal.request.draft)],
+        [
+            "== Résultat ==",
+            f"Statut : {STATUS_LABELS[proposal.status.code]}",
+            explanation_message(status),
+        ],
+        ["== Offres du catalogue ==", *_offer_lines(proposal)],
+        ["== Négociations individuelles (simulation) ==", *_solo_lines(proposal)],
+    ]
+    if proposal.block is not None:
+        title = "== Groupe constitué ==" if len(proposal.block.members) > 1 else "== Votre bloc =="
+        sections.append([title, *_block_lines(proposal)])
+        sections.append(["== Répartition calculée ==", *_allocation_lines(proposal)])
+        sections.append(["== Paiements par voyageur ==", *_traveller_lines(proposal)])
+    others = list(proposal.explanations[1:])
+    if others:
+        sections.append(
+            ["== Explications ==", *(f"- {explanation_message(item)}" for item in others)]
+        )
+    sections.append(["== Provenance ==", *_provenance_lines(proposal)])
+    text = "\n\n".join("\n".join(section) for section in sections) + "\n"
+    return ensure_vocabulary(text)
+
+
+# --- status messages (standard error) -----------------------------------------------------
+
+
+def _invalid_text(errors) -> str:
+    lines = ["Demande invalide (détail technique) :"]
+    for error in errors:
+        if error.startswith(FORBIDDEN_TERM_PREFIX):
+            lines.append(f"- {forbidden_term_message(error[len(FORBIDDEN_TERM_PREFIX) :])}")
+        else:
+            lines.append(f"- {error}")
+    return "\n".join(lines)
+
+
+def render_status_text(document: Mapping) -> str:
+    """Message for a request without proposal (exit codes 2, 3 and 4)."""
+    status = document["status"]
+    if status == "needs_clarification":
+        text = "Clarification requise. " + needs_clarification_message(document["missing_fields"])
+    elif status == "invalid":
+        text = _invalid_text(document["errors"])
+    elif status == "request_rejected":
+        reason = document["reason"]
+        if reason in REQUEST_REJECTION_MESSAGES:
+            text = "Demande non retenue. " + REQUEST_REJECTION_MESSAGES[reason]
+        elif document["rejection_status"] == "needs_clarification":
+            text = "Clarification requise. " + needs_clarification_message(
+                document["missing_fields"]
+            )
+        else:
+            text = _invalid_text(document["errors"])
+    else:
+        text = "Demande non validée : aucune simulation n'a été lancée."
+    return ensure_vocabulary(text + "\n")
diff -ruN -x __pycache__ -x *.egg-info -x .DS_Store a/Multi-Agent/coalition_travel/infrastructure/presentation/vocabulary.py b/Multi-Agent/coalition_travel/infrastructure/presentation/vocabulary.py
--- a/Multi-Agent/coalition_travel/infrastructure/presentation/vocabulary.py	1970-01-01 01:00:00
+++ b/Multi-Agent/coalition_travel/infrastructure/presentation/vocabulary.py	2026-11-20 04:02:44
@@ -0,0 +1,68 @@
+"""Vocabulary rule of the simulated proposal (plan §1.2; scope review §7.2, D-I3-17).
+
+The rule is normative and has no exception: the text is put in NFC, case-folded, split
+into whole words at Unicode word boundaries (``re.findall(r"\\w+")``), and each word is
+compared with the forbidden list. Words that merely *contain* a forbidden word
+("réservation", "émission", "confirmation") pass.
+
+User-supplied strings are never rewritten (D-I3-17): a request whose destination,
+profile identifier or excluded supplier contains a forbidden word is refused before any
+display, with a message that names the field and never quotes the value.
+"""
+
+import re
+import unicodedata
+from collections.abc import Iterator
+
+from coalition_travel.application.request_contracts import TravelRequestDraft
+
+FORBIDDEN_WORDS = frozenset(
+    unicodedata.normalize("NFC", word)
+    for word in (
+        "billet",
+        "billets",
+        "réservé",
+        "réservée",
+        "réservés",
+        "réservées",
+        "confirmé",
+        "confirmée",
+        "confirmés",
+        "confirmées",
+        "émis",
+        "émise",
+        "émises",
+    )
+)
+_WORD = re.compile(r"\w+")
+
+
+def words(text: str) -> list[str]:
+    """Whole words of ``text`` after NFC and casefold, at Unicode word boundaries."""
+    folded = unicodedata.normalize("NFC", unicodedata.normalize("NFC", text).casefold())
+    return _WORD.findall(folded)
+
+
+def forbidden_words_in(text: str) -> tuple[str, ...]:
+    return tuple(sorted({word for word in words(text) if word in FORBIDDEN_WORDS}))
+
+
+def contains_forbidden_word(text: str) -> bool:
+    return bool(forbidden_words_in(text))
+
+
+def user_strings(draft: TravelRequestDraft) -> Iterator[tuple[str, str]]:
+    """(path, value) of every free string supplied by the person (D-I3-17)."""
+    if draft.destination is not None:
+        yield "destination", draft.destination
+    for index, supplier in enumerate(draft.excluded_suppliers):
+        yield f"excluded_suppliers[{index}]", supplier
+    for index, profile in enumerate(draft.profiles):
+        yield f"profiles[{index}].profile_id", profile.profile_id
+        for position, supplier in enumerate(profile.excluded_suppliers or ()):
+            yield f"profiles[{index}].excluded_suppliers[{position}]", supplier
+
+
+def forbidden_user_fields(draft: TravelRequestDraft) -> tuple[str, ...]:
+    """Paths of the user strings that contain a forbidden word, in field order."""
+    return tuple(path for path, value in user_strings(draft) if contains_forbidden_word(value))
diff -ruN -x __pycache__ -x *.egg-info -x .DS_Store a/Multi-Agent/plan_trip.py b/Multi-Agent/plan_trip.py
--- a/Multi-Agent/plan_trip.py	1970-01-01 01:00:00
+++ b/Multi-Agent/plan_trip.py	2026-11-20 04:09:58
@@ -0,0 +1,373 @@
+"""coalition-travel-plan: one travel request to a simulated proposal (step I3-C).
+
+Flow (scope review §6.2): options, reference date, catalogue v1 and demand pool v1, the
+request (``--draft-json``, ``--prompt`` or interactive input, with at most three
+clarification rounds), the vocabulary check of the person's strings (D-I3-17), the summary
+of the understood request, the explicit validation (ID-10, unless ``--yes``), then
+``plan_travel_request`` and the text or JSON output.
+
+Streams: standard output receives only the final document (the proposal, or with
+``--json`` the status document of §6.4); questions, summary and messages go to standard
+error. Exit codes: 0 proposal, 1 technical error, 2 clarification needed, 3 invalid
+request, 4 request not validated, 64 incorrect usage, 130 interruption.
+
+Demonstration mode only (ID-1): the versioned catalogue v1 and demand pool v1.
+"""
+
+import argparse
+import asyncio
+import os
+import re
+import sys
+from datetime import date
+from pathlib import Path
+
+from coalition_travel.application.request_contracts import TravelRequestDraft
+from coalition_travel.application.request_understanding import (
+    RequestInputError,
+    understand_request,
+    validate_request_draft,
+)
+from coalition_travel.application.travel_workflow import plan_travel_request
+from coalition_travel.application.trip_proposal import (
+    draft_json_extraction,
+    llm_extraction,
+    replay_extraction,
+)
+from coalition_travel.infrastructure.demand.demand_pool import load_demand_pool
+from coalition_travel.infrastructure.llm.ollama import OllamaStructuredRequestExtractor
+from coalition_travel.infrastructure.llm.replay import ReplayStructuredRequestExtractor
+from coalition_travel.infrastructure.negotiation.market import open_simulated_market
+from coalition_travel.infrastructure.presentation.explanations_fr import CLARIFICATION_QUESTIONS
+from coalition_travel.infrastructure.presentation.json_renderer import (
+    forbidden_term_error,
+    invalid_document,
+    needs_clarification_document,
+    not_validated_document,
+    reduce_validation_error,
+    render_proposal_json,
+    render_status_json,
+    request_rejected_document,
+)
+from coalition_travel.infrastructure.presentation.text_renderer import (
+    render_proposal_text,
+    render_request_summary,
+    render_status_text,
+)
+from coalition_travel.infrastructure.presentation.vocabulary import forbidden_user_fields
+from pydantic import ValidationError
+
+ROOT = Path(__file__).resolve().parents[1]
+CATALOG_PATH = ROOT / "data" / "catalog" / "catalog_v1.json"
+POOL_PATH = ROOT / "data" / "demand" / "demand_pool_v1.jsonl"
+
+EXIT_OK = 0
+EXIT_TECHNICAL = 1
+EXIT_CLARIFICATION = 2
+EXIT_INVALID = 3
+EXIT_NOT_VALIDATED = 4
+EXIT_USAGE = 64  # sysexits EX_USAGE (D-I3-3)
+EXIT_INTERRUPTED = 130
+
+MAX_CLARIFICATION_ROUNDS = 3
+ACCEPTED_ANSWERS = frozenset({"o", "oui"})
+REQUEST_QUESTION = "Décrivez votre demande de voyage : "
+VALIDATION_QUESTION = "Valider cette demande et lancer la simulation ? [o/N] "
+_ISO_DATE = re.compile(r"\d{4}-\d{2}-\d{2}")
+_ABSOLUTE_PATH = re.compile(r"(?<![\w.])/(?:[^\s'\":/]+/)+[^\s'\":/]*")
+
+
+class UsageError(Exception):
+    """Incorrect use of the command: exit code 64, with a message in French."""
+
+
+class _Parser(argparse.ArgumentParser):
+    def error(self, message):
+        if message.startswith("unrecognized arguments"):
+            raise UsageError("option inconnue.")
+        if "expected one argument" in message:
+            raise UsageError("une option attend une valeur.")
+        raise UsageError("options incorrectes.")
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = _Parser(
+        prog="coalition-travel-plan",
+        description=(
+            "Proposition simulée pour une demande de voyage : catalogue et vendeurs fictifs, "
+            "aucune réservation."
+        ),
+    )
+    source = parser.add_argument_group("demande")
+    source.add_argument("--prompt", metavar="TEXTE", help="demande en langage naturel")
+    source.add_argument(
+        "--draft-json", metavar="FICHIER", help="demande structurée (TravelRequestDraft)"
+    )
+    source.add_argument(
+        "--extractor-replay",
+        metavar="FICHIER",
+        help="rejeu de brouillons enregistrés, à la place du modèle (test et démonstration)",
+    )
+    parser.add_argument(
+        "--reference-date", metavar="AAAA-MM-JJ", help="date de référence (défaut : aujourd'hui)"
+    )
+    parser.add_argument("--yes", action="store_true", help="valider la demande sans question")
+    parser.add_argument("--json", action="store_true", help="sortie JSON canonique")
+    return parser
+
+
+class _Command:
+    def __init__(self, stdin, stdout, stderr, environ, open_market, load_pool, today):
+        self.stdin, self.stdout, self.stderr = stdin, stdout, stderr
+        self.environ, self.open_market, self.load_pool = environ, open_market, load_pool
+        self.today = today
+        self.paths: dict[str, str] = {}
+        self.source = "draft-json"
+        self.reference_date: date | None = None
+        self.as_json = False
+
+    # --- streams --------------------------------------------------------------------
+
+    def say(self, text: str) -> None:
+        self.stderr.write(text if text.endswith("\n") else text + "\n")
+        self.stderr.flush()
+
+    def ask(self, question: str) -> str:
+        self.stderr.write(question)
+        self.stderr.flush()
+        return self.stdin.readline()
+
+    def sanitize(self, message: str) -> str:
+        """No file path in any message (B10): known paths become names, others a mark."""
+        for path, label in sorted(self.paths.items(), key=lambda item: -len(item[0])):
+            message = message.replace(path, label)
+        return _ABSOLUTE_PATH.sub("<chemin>", message)
+
+    def remember(self, path, label: str) -> None:
+        for variant in {str(path), str(Path(path).absolute()), str(Path(path).resolve())}:
+            self.paths[variant] = label
+
+    # --- steps ----------------------------------------------------------------------
+
+    def parse(self, argv):
+        args = build_parser().parse_args(argv)
+        if args.prompt is not None and args.draft_json is not None:
+            raise UsageError("--prompt et --draft-json ne peuvent pas être utilisées ensemble.")
+        if args.extractor_replay is not None and args.draft_json is not None:
+            raise UsageError("--extractor-replay ne s'utilise qu'avec --prompt ou la saisie.")
+        if args.reference_date is None:
+            self.reference_date = self.today()
+        else:
+            try:
+                if not _ISO_DATE.fullmatch(args.reference_date):
+                    raise ValueError
+                self.reference_date = date.fromisoformat(args.reference_date)
+            except ValueError:
+                raise UsageError("la date de référence doit avoir la forme AAAA-MM-JJ.") from None
+        self.as_json = args.json
+        return args
+
+    def read_inputs(self, args):
+        """Input files are read with the options: an unreadable file is a usage error."""
+        draft_bytes = extractor = None
+        if args.draft_json is not None:
+            self.remember(args.draft_json, "--draft-json")
+            try:
+                draft_bytes = Path(args.draft_json).read_bytes()
+            except OSError:
+                raise UsageError("Fichier de --draft-json introuvable ou illisible.") from None
+            return draft_bytes, None
+        if args.extractor_replay is not None:
+            self.remember(args.extractor_replay, "--extractor-replay")
+            self.source = "replay"
+            try:
+                extractor = ReplayStructuredRequestExtractor(args.extractor_replay)
+            except OSError:
+                raise UsageError(
+                    "Fichier de --extractor-replay introuvable ou illisible."
+                ) from None
+            return None, extractor
+        model = self.environ.get("OLLAMA_MODEL", "").strip()
+        if not model:
+            raise UsageError(
+                "--prompt et la saisie demandent la variable OLLAMA_MODEL, "
+                "ou l'option --extractor-replay."
+            )
+        self.source = "llm"
+        base_url = self.environ.get("OLLAMA_BASE_URL", "http://localhost:11434")
+        return None, OllamaStructuredRequestExtractor(model, base_url=base_url)
+
+    def extraction(self, extractor):
+        if self.source == "draft-json":
+            return draft_json_extraction()
+        if self.source == "replay":
+            return replay_extraction()
+        return llm_extraction(extractor.model)
+
+    def common(self) -> dict:
+        return {"source": self.source, "reference_date": self.reference_date}
+
+    def from_draft_json(self, draft_bytes):
+        try:
+            draft = TravelRequestDraft.model_validate_json(draft_bytes)
+        except ValidationError as exc:
+            return invalid_document(errors=reduce_validation_error(exc), **self.common())
+        refused = self.refuse_forbidden_strings(draft)
+        if refused is not None:
+            return refused
+        validation = validate_request_draft(draft, self.reference_date)
+        if validation.status == "needs_clarification":
+            return needs_clarification_document(
+                missing_fields=validation.missing_fields, rounds=0, **self.common()
+            )
+        if validation.status == "invalid":
+            return invalid_document(errors=validation.errors, **self.common())
+        return draft
+
+    def refuse_forbidden_strings(self, draft):
+        """D-I3-17: before any display derived from the request, without rewriting it."""
+        paths = forbidden_user_fields(draft)
+        if not paths:
+            return None
+        return invalid_document(
+            errors=[forbidden_term_error(path) for path in paths], **self.common()
+        )
+
+    def from_text(self, text, extractor):
+        if text is None:
+            text = self.ask(REQUEST_QUESTION).rstrip("\n")
+        rounds = 0
+        while True:
+            try:
+                result = asyncio.run(understand_request(text, extractor, self.reference_date))
+            except RequestInputError as exc:
+                return invalid_document(errors=[str(exc)], **self.common())
+            if result.request is not None:
+                refused = self.refuse_forbidden_strings(result.request)
+                if refused is not None:
+                    return refused
+            if result.status == "ready":
+                return result.request
+            if result.status == "invalid":
+                return invalid_document(errors=result.errors, **self.common())
+            missing = result.missing_fields
+            if rounds == MAX_CLARIFICATION_ROUNDS:
+                return needs_clarification_document(
+                    missing_fields=missing, rounds=rounds, **self.common()
+                )
+            questions = " ".join(CLARIFICATION_QUESTIONS[field] for field in missing)
+            answer = self.ask(f"Précision {rounds + 1}/{MAX_CLARIFICATION_ROUNDS} : {questions} ")
+            if answer == "":  # end of input during a round
+                return needs_clarification_document(
+                    missing_fields=missing, rounds=rounds, **self.common()
+                )
+            text = text + "\n" + answer.rstrip("\n")
+            rounds += 1
+
+    def validated(self, yes: bool):
+        """None when the person validates; otherwise the not_validated document."""
+        if yes:
+            return None
+        answer = self.ask(VALIDATION_QUESTION)
+        if answer == "":
+            reason = "end_of_input"
+        elif not answer.strip():
+            reason = "empty_answer"
+        elif answer.strip().casefold() in ACCEPTED_ANSWERS:
+            return None
+        else:
+            reason = "refused"
+        return not_validated_document(reason=reason, **self.common())
+
+    def finish_with_status(self, document) -> int:
+        text, code = render_status_json(document)  # validated before any writing
+        self.say(render_status_text(document))
+        if self.as_json:
+            self.stdout.write(text)
+            self.stdout.flush()
+        return code
+
+    def execute(self, argv) -> int:
+        args = self.parse(argv)
+        draft_bytes, extractor = self.read_inputs(args)
+        self.remember(CATALOG_PATH, CATALOG_PATH.name)
+        self.remember(POOL_PATH, POOL_PATH.name)
+        market = self.open_market(CATALOG_PATH, self.reference_date)
+        pool = self.load_pool(POOL_PATH)
+        if draft_bytes is not None:
+            obtained = self.from_draft_json(draft_bytes)
+        else:
+            obtained = self.from_text(args.prompt, extractor)
+        if not isinstance(obtained, TravelRequestDraft):
+            return self.finish_with_status(obtained)
+        draft = obtained
+        self.say(render_request_summary(draft))
+        refusal = self.validated(args.yes)
+        if refusal is not None:
+            return self.finish_with_status(refusal)
+        self.say("Demande validée : simulation en cours.")
+        result = plan_travel_request(
+            draft,
+            market=market,
+            pool=pool,
+            reference_date=self.reference_date,
+            extraction=self.extraction(extractor),
+        )
+        if result.proposal is None:
+            rejection = result.plan.rejections[0]
+            return self.finish_with_status(
+                request_rejected_document(rejection=rejection, **self.common())
+            )
+        if self.as_json:
+            output = render_proposal_json(result.proposal)
+        else:
+            output = render_proposal_text(result.proposal)
+        self.stdout.write(output)
+        self.stdout.flush()
+        return EXIT_OK
+
+
+def run(
+    argv,
+    *,
+    stdin=None,
+    stdout=None,
+    stderr=None,
+    environ=None,
+    open_market=open_simulated_market,
+    load_pool=load_demand_pool,
+    today=date.today,
+) -> int:
+    """Run the command and return its exit code; the streams can be replaced in tests."""
+    command = _Command(
+        stdin or sys.stdin,
+        stdout or sys.stdout,
+        stderr or sys.stderr,
+        os.environ if environ is None else environ,
+        open_market,
+        load_pool,
+        today,
+    )
+    try:
+        return command.execute(argv)
+    except KeyboardInterrupt:
+        command.say("\nInterruption : aucune proposition n'a été produite.")
+        return EXIT_INTERRUPTED
+    except UsageError as exc:
+        command.say(f"Usage incorrect : {exc}")
+        command.say(build_parser().format_usage())
+        return EXIT_USAGE
+    except OSError as exc:
+        command.say(f"Erreur technique : {type(exc).__name__}: {exc.strerror or 'erreur système'}")
+        return EXIT_TECHNICAL
+    except Exception as exc:  # noqa: BLE001 -- top level: any other failure is technical (code 1)
+        command.say(f"Erreur technique : {type(exc).__name__}: {command.sanitize(str(exc))}")
+        return EXIT_TECHNICAL
+
+
+def main() -> None:
+    sys.exit(run(sys.argv[1:]))
+
+
+if __name__ == "__main__":
+    main()
