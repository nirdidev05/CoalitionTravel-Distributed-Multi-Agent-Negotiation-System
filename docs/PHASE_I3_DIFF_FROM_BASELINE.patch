+
+# --- explanation parameters: one closed class per code ------------------------------------
+
+
+@dataclass(frozen=True)
+class NoAdmissibleOfferParams:
+    rejected_offers: int
+
+
+@dataclass(frozen=True)
+class NoSoloReferenceParams:
+    failed_attempts: int
+
+
+@dataclass(frozen=True)
+class ComponentTooLargeParams:
+    component_units: int
+    max_component_units: int
+
+
