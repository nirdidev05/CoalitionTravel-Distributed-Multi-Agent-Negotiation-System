+def json_keys(node, found=None):
+    found = set() if found is None else found
+    if isinstance(node, dict):
+        for key, value in node.items():
+            found.add(key)
+            json_keys(value, found)
+    elif isinstance(node, list):
+        for value in node:
+            json_keys(value, found)
+    return found
